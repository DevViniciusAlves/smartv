{
  "manifest_version": 3,
  "name": "Smart TV Spatial Nav",
  "version": "1.0.0",
  "description": "Navegação por foco com as setas nos serviços de streaming.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.netflix.com/*",
        "https://www.hbomax.com/*",
        "https://www.max.com/*",
        "https://www.disneyplus.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
