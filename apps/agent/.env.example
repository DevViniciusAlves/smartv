BACKEND_URL=wss://seu-servico.onrender.com/ws
AGENT_TOKEN=troque-este-token-agente
BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
BROWSER_PROFILE_DIR=%USERPROFILE%\smartv-edge-profile
LAUNCHER_URL=https://seu-app.vercel.app/tv
TV_WINDOW_X=1920
TV_WINDOW_Y=0
# back: alt-left (padrão) ou esc
BACK_BEHAVIOR=alt-left
# tv: kiosk (padrão, sem barra/abas) ou app (janela de app em tela cheia)
TV_MODE=kiosk
# porta do Chrome DevTools Protocol (somente 127.0.0.1, nunca expor)
CDP_PORT=9222
# navigation target: edge (padrao, janela do Edge via CDP) ou electron
# (app desktop via CDP; exige o app aberto com --smartv-cdp=PORTA)
TV_TARGET=edge
